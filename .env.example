# ── Vivahaa Elite Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=5173

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vivahaa_elite?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate real random secrets for these, e.g. `openssl rand -base64 48`
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google OAuth 2.0 — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@vivahaaelite.com"

# Session
SESSION_SECRET=""
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend / Backend URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# Razorpay — Step 5 membership checkout (server/routes/payments.js). Without these,
# order-creation returns a clean "payments not configured" error rather than crashing.
# Get Key ID/Secret from https://dashboard.razorpay.com/app/keys, and the Webhook
# Secret from Settings -> Webhooks when you register the /api/payments/razorpay/webhook
# endpoint there (subscribe to payment.captured and payment.failed).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Set to exactly "true" to let Step 5's checkout complete registration via a synthetic
# payment instead of a real Razorpay one (server/routes/payments.js's POST
# /api/payments/demo/complete) — for demoing/testing the full signup flow before real
# Razorpay keys are live. Leave unset once real payments are wired up.
ALLOW_DEMO_PAYMENTS=""

# MSG91 — SMS half of the post-payment "set your password" notice (server/lib/sms.js).
# Needs a DLT-registered template id approved in the MSG91 dashboard for transactional
# SMS to Indian numbers. Without these, the SMS is logged instead of sent.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Demo mode — MUST be unset/false in production. The backend also hard-gates
# the demo-login route behind NODE_ENV !== 'production' regardless of this flag.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
