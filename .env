# ── Vivahaa Elite Environment Variables ──────────────────────────────────────
NODE_ENV=development
PORT=5173

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vivahaa_elite?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="vivahaa-elite-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="vivahaa-elite-refresh-secret-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@vivahaaelite.com"

# Session
SESSION_SECRET="vivahaa-session-secret-change-in-production"
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:4000"

# Demo mode (development only)
DEMO_MODE=true
DEMO_ADMIN_EMAIL="admin@vivahaaelite.demo"
DEMO_ADMIN_PASSWORD="Admin@123"
DEMO_USER_EMAIL="demo@vivahaaelite.demo"
DEMO_USER_PASSWORD="Demo@123"
